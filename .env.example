# Copy this file to .env and fill in the providers you plan to use.

# LLM provider to use. Options: gpt4o-mini, gpt4o, groq, claude, gemini, ollama
LLM_PROVIDER=claude

# Ollama settings (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:32b

GPT4O_MINI_API_KEY=
GPT4O_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional runtime override for the ontology path.
# MPBOOT_ONTOLOGY_PATH=src/inputs/ontology/ontology.owl

# Evaluation defaults
# MPBOOT_RODI_ROOT=.tools/rodi
# MPBOOT_DB_SETUP=auto
# MPBOOT_DB_HOST=localhost
# MPBOOT_DB_PORT=5433
# MPBOOT_DB_NAME=rodi
# MPBOOT_DB_USER=postgres
# MPBOOT_DB_PASSWORD=postgres
# MPBOOT_DB_CMD=.tools/bin/psql_docker.sh
# MPBOOT_RODI_REASONING=structural
# MPBOOT_PG_CONTAINER=mpboot-postgres
# MPBOOT_PG_IMAGE=postgres:11

ANTHROPIC_MOCK_HOST=127.0.0.1
ANTHROPIC_MOCK_PORT=8000
ANTHROPIC_MOCK_MODE=passthrough
ANTHROPIC_MOCK_DB=anthropic_mock_server/cache.sqlite3
ANTHROPIC_REAL_BASE_URL=https://api.anthropic.com
# Optional: separate upstream key for the proxy. Falls back to ANTHROPIC_API_KEY.
# ANTHROPIC_REAL_API_KEY=
ANTHROPIC_MOCK_LOG_LEVEL=INFO
ANTHROPIC_PROXY_URL=

MPBOOT_R2RML_FORCE_DOUBLE_FOR_DECIMALS=false 
